[binaries]
c = 'emcc'
cpp = 'em++'
ar = 'emar'
ranlib = 'emranlib'
strip = 'emstrip'
pkg-config = 'pkg-config'
exe_wrapper = 'node'

[properties]
needs_exe_wrapper = true

[built-in options]
c_args = ['-fexceptions', '-O2']
cpp_args = ['-fexceptions', '-O2']
c_link_args = ['-fexceptions', '-L/work/prefix/lib']
cpp_link_args = ['-fexceptions', '-L/work/prefix/lib']
default_library = 'static'
prefix = '/work/prefix'

[host_machine]
system = 'emscripten'
cpu_family = 'wasm32'
cpu = 'wasm32'
endian = 'little'
