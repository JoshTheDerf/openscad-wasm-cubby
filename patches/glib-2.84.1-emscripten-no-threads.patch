Build glib without threads on Emscripten. Meson's Emscripten support adds
-pthread for dependency('threads'), with no option to turn it off. OpenSCAD's
module is single-threaded (no shared memory), and objects built with -pthread
(atomics) can't be linked into it. Emscripten's libc keeps the pthread API as
single-threaded stubs, so glib's POSIX thread code still compiles and links.

The same libc declares pthread_getname_np() and posix_spawn()/posix_spawnp()
without implementing them (there are no processes in a browser), and glib's
header-only checks took them as present: undefined symbols at link time.
Skip those checks on Emscripten.

--- a/meson.build
+++ b/meson.build
@@ -870,7 +870,7 @@
 endif
 
 # Check that posix_spawn() is usable; must use header
-if cc.has_function('posix_spawn', prefix : '#include <spawn.h>')
+if host_system != 'emscripten' and cc.has_function('posix_spawn', prefix : '#include <spawn.h>')
   glib_conf.set('HAVE_POSIX_SPAWN', 1)
 endif
 
@@ -2116,7 +2116,9 @@
   glibconfig_conf.set('g_threads_impl_def', 'WIN32')
   glib_conf.set('THREADS_WIN32', 1)
 else
-  thread_dep = dependency('threads')
+  # Emscripten: no -pthread. Its libc keeps the pthread API as single-threaded
+  # stubs; threads would need SharedArrayBuffer and a pthread build of the app.
+  thread_dep = host_system == 'emscripten' ? [] : dependency('threads')
   threads_implementation = 'posix'
   pthread_prefix = '''
       #ifndef _GNU_SOURCE
@@ -2137,7 +2139,7 @@
   if cc.has_header_symbol('pthread.h', 'pthread_cond_timedwait_relative_np')
     glib_conf.set('HAVE_PTHREAD_COND_TIMEDWAIT_RELATIVE_NP', 1)
   endif
-  if cc.has_header_symbol('pthread.h', 'pthread_getname_np', prefix : pthread_prefix)
+  if host_system != 'emscripten' and cc.has_header_symbol('pthread.h', 'pthread_getname_np', prefix : pthread_prefix)
     glib_conf.set('HAVE_PTHREAD_GETNAME_NP', 1)
   endif
   if cc.has_header_symbol('pthread.h', 'pthread_getaffinity_np', prefix : pthread_prefix)
